NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Thông tin ngân hàng để sinh mã VietQR ở trang "Đặt hàng thành công".
# BANK_ID dùng mã ngân hàng VietQR (vd: mbbank, vietcombank, acb...) hoặc số BIN.
# Chưa cấu hình thì trang thành công vẫn chạy, chỉ ẩn phần QR.
BANK_ID=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=

# --- Khu vực /admin (back-office nội bộ, có auth) ---

# Service role key — chỉ dùng server-side (lib/admin/supabaseServer.ts,
# app/api/admin/*) để bypass RLS khi cần. KHÔNG BAO GIỜ import vào Client
# Component hay để lộ vào bundle trình duyệt.
SUPABASE_SERVICE_ROLE_KEY=

# Đồng bộ sản phẩm từ Google Sheet (lib/admin/googleSheetSync.ts).
GOOGLE_API_KEY=
GOOGLE_SHEET_ID=

# Bearer secret cho GitHub Actions gọi POST /api/admin/sync-sheet mà không
# cần đăng nhập (endpoint này được middleware.ts whitelist riêng).
SYNC_SECRET=
