{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    // Code ported từ trabanh (Next 14, tsconfig strict:false) — nhất là
    // app/(admin)/admin/HomeClient.tsx — dựa vào suy luận kiểu lỏng ở nhiều
    // tham số callback nội bộ (không phải lỗi thật). Tắt riêng noImplicitAny
    // để build pass mà không phải sửa tay hàng trăm chỗ; các strict check
    // khác (strictNullChecks...) vẫn bật để bắt lỗi thật liên quan tới
    // Next 15+ (params/cookies() async...).
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
